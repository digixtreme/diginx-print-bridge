<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="DigiNx Print Bridge"
    Manufacturer="DigiXtreme Technology Solutions"
    Version="1.2.0"
    UpgradeCode="{E140994B-8468-4F02-99B3-E9AB5F59D9EE}"
    Scope="perUser"
    InstallerVersion="500"
    Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of DigiNx Print Bridge is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="DigiNxLocalFolder" Name="DigiNx">
        <Directory Id="INSTALLFOLDER" Name="PrintBridge">
          <Component Id="BridgeApplication" Guid="*">
            <File Id="BridgeExe" Source="payload\DigiNx.PrintBridge.exe" KeyPath="yes" />
            <RegistryValue
              Root="HKCU"
              Key="Software\Microsoft\Windows\CurrentVersion\Run"
              Name="DigiNx Print Bridge"
              Type="string"
              Value="&quot;[INSTALLFOLDER]DigiNx.PrintBridge.exe&quot;" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DigiNxProgramMenu" Name="DigiNx">
        <Component Id="BridgeShortcuts" Guid="*">
          <Shortcut
            Id="StartBridgeShortcut"
            Name="DigiNx Print Bridge"
            Description="Start DigiNx Print Bridge"
            Target="[INSTALLFOLDER]DigiNx.PrintBridge.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <Shortcut
            Id="ConfigureBridgeShortcut"
            Name="Configure DigiNx Print Bridge"
            Description="Configure the DigiNx POS browser URL for Direct Print"
            Target="[INSTALLFOLDER]DigiNx.PrintBridge.exe"
            Arguments="--configure"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveDigiNxProgramMenu" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\DigiXtreme\DigiNx Print Bridge"
            Name="Installed"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="DigiNx Print Bridge" Level="1">
      <ComponentRef Id="BridgeApplication" />
      <ComponentRef Id="BridgeShortcuts" />
    </Feature>
  </Package>
</Wix>
